---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../lib/site';
import { DEFAULT_LOCALE, LOCALES, localizePath, ui, unlocalizePath, useI18n } from '../i18n';

interface Props {
  /** Page title; the home page passes none and gets the bare site name with the tagline. */
  title?: string;
  description?: string;
  /** Pages that shouldn't be indexed (the no-JS waitlist result, 404). */
  noindex?: boolean;
  /** hreflang alternates; off for 404s, whose URL is whatever was mistyped. */
  alternates?: boolean;
}

const { locale, t } = useI18n(Astro);
const { title, description = t.meta.description, noindex = false, alternates = true } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : t.meta.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(t.meta.ogImage, Astro.site);

// The same page in every language, plus x-default (English) for everyone else.
const basePath = unlocalizePath(Astro.url.pathname);
const alternateLinks = alternates
  ? [
      ...LOCALES.map((l) => ({ hreflang: l, href: new URL(localizePath(basePath, l), Astro.site) })),
      { hreflang: 'x-default', href: new URL(localizePath(basePath, DEFAULT_LOCALE), Astro.site) },
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web, iOS, Android',
  description: t.meta.description,
  inLanguage: locale,
  url: new URL(localizePath('/', locale), Astro.site).toString(),
};

// Before paint: stored choice, else the OS. Toggles and the footer setting keep it in step afterwards.
const themeInit = `(function(){try{var t=localStorage.getItem('theme');var d=t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches);var r=document.documentElement;r.classList.toggle('dark',d);r.dataset.theme=t==='light'||t==='dark'?t:'system'}catch(e){}})();`;
---

<!doctype html>
<html lang={locale} data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={themeInit} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/icons/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/apple-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1c1917" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={ui[l].meta.ogLocale} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-primary px-3 py-2 text-sm text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t.skipToContent}
    </a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
