---
import { ShieldCheck, Wrench } from '@lucide/astro';
import { Image } from 'astro:assets';
import capy from '../../assets/capy-icon.png';

/** A Claude conversation using the Capybudget MCP server, ending on the approval prompt destructive tools raise. */
---

<div
  role="img"
  aria-label="A conversation with Claude: it reads the Capybudget budget to answer a spending question, then asks for approval before deleting duplicate transactions."
  class="flex flex-col gap-3 rounded-xl border border-border bg-card p-4 text-[13px] shadow-mock sm:p-5"
>
  <div aria-hidden="true" inert class="flex flex-col gap-3">
    <div class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-muted px-3.5 py-2">
      How much have we spent eating out this month?
    </div>

    <span class="flex w-fit items-center gap-1.5 rounded-md border border-border px-2 py-1 text-[11px] text-muted-foreground">
      <Wrench class="size-3" /> Capybudget · get_budget_month
    </span>

    <p class="max-w-[92%] leading-relaxed">
      <span class="font-number font-medium tabular-nums">$171.40</span> on Dining out in November, which is
      <span class="font-number font-medium text-danger-foreground tabular-nums">$21.40</span> over what you assigned. I
      also spotted 3 duplicate Uber charges that look like they were entered twice.
    </p>

    <div class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-muted px-3.5 py-2">Delete the duplicates.</div>

    <span class="flex w-fit items-center gap-1.5 rounded-md border border-border px-2 py-1 text-[11px] text-muted-foreground">
      <Wrench class="size-3" /> Capybudget · delete_transactions
    </span>

    <!-- The MCP approval form: the tool's confirm message plus the "approve" checkbox (src/lib/mcp/approval.ts). -->
    <div class="flex flex-col gap-2.5 rounded-lg border border-border bg-background p-3">
      <span class="flex items-center gap-2 font-medium">
        <Image src={capy} alt="" width={18} height={18} densities={[1, 2]} />
        Capybudget is asking for approval
      </span>
      <span class="text-xs leading-relaxed">
        Delete 3 transaction(s), and the other side of any transfer among them?
        <br />
        <span class="text-muted-foreground">This cannot be undone.</span>
      </span>
      <span class="flex items-center gap-2 text-xs">
        <span class="flex size-4 items-center justify-center rounded-[4px] border border-primary bg-primary text-primary-foreground">
          <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        approve <span class="text-muted-foreground">· Tick to approve, then accept</span>
      </span>
      <span class="flex gap-2">
        <span class="flex items-center gap-1 rounded-md bg-primary px-2.5 py-1 text-xs font-medium text-primary-foreground">
          <ShieldCheck class="size-3.5" /> Accept
        </span>
        <span class="rounded-md border border-border px-2.5 py-1 text-xs font-medium">Decline</span>
      </span>
    </div>
  </div>
</div>
