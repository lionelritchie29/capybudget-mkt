---
import { Repeat } from '@lucide/astro';

const rows = [
  { day: 'Dec 1', name: 'Rent', every: 'Monthly', amount: '-$1,850.00' },
  { day: 'Dec 1', name: 'Transfer to Savings', every: 'Monthly', amount: '-$300.00' },
  { day: 'Dec 3', name: 'Netflix', every: 'Monthly', amount: '-$15.49' },
  { day: 'Dec 15', name: 'Paycheck', every: 'Twice a month', amount: '+$3,200.00', income: true },
];
---

<ul class="flex flex-col text-[13px]">
  {rows.map((row) => (
    <li class="flex items-center gap-3 border-b border-border/60 py-2 last:border-b-0">
      <span class="w-11 shrink-0 text-xs text-muted-foreground">{row.day}</span>
      <span class="min-w-0 flex-1">
        <span class="block truncate">{row.name}</span>
        <span class="flex items-center gap-1 text-[11px] text-muted-foreground">
          <Repeat class="size-3" /> {row.every}
        </span>
      </span>
      <span class:list={['font-number tabular-nums', row.income && 'text-success-foreground']}>{row.amount}</span>
    </li>
  ))}
</ul>
