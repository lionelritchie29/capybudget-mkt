---
import { ChartColumn, ChevronDown, ChevronLeft, ChevronRight, LayoutGrid, Receipt } from '@lucide/astro';
import { Image } from 'astro:assets';
import capy from '../../assets/capy-icon.png';
import AvailablePill from './AvailablePill.astro';
import MockFrame from './MockFrame.astro';
import { DEMO_ACCOUNTS, DEMO_GROUPS, DEMO_MONTH, READY_TO_ASSIGN } from '../../content/demo-budget';
import { formatUsd } from '../../lib/money';

/** The Plan screen: sidebar, month, Ready to Assign strip and the category table. Phones drop the sidebar and Activity, like the app. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const groupTotal = (key: 'assigned' | 'activity' | 'available', index: number) =>
  DEMO_GROUPS[index].categories.reduce((sum, c) => sum + c[key], 0);
---

<MockFrame
  url="app.capybudget.site"
  label="The Capybudget Plan screen: $640 ready to assign, with Bills, Everyday and Goals categories showing assigned, activity and available amounts."
  class={className}
>
  <div class="@container">
    <div class="flex text-[13px]">
      <aside class="hidden w-48 shrink-0 flex-col gap-4 border-r border-border bg-sidebar p-3 @3xl:flex">
        <div class="flex items-center gap-2 px-1.5 py-1">
          <Image src={capy} alt="" width={20} height={20} densities={[1, 2]} />
          <span class="font-semibold">Household</span>
          <ChevronDown class="ml-auto size-3.5 text-muted-foreground" />
        </div>
        <nav class="flex flex-col gap-0.5">
          <span class="flex items-center gap-2 rounded-md bg-muted px-2 py-1.5 font-medium">
            <LayoutGrid class="size-4" /> Plan
          </span>
          <span class="flex items-center gap-2 rounded-md px-2 py-1.5 text-muted-foreground">
            <ChartColumn class="size-4" /> Reports
          </span>
          <span class="flex items-center gap-2 rounded-md px-2 py-1.5 text-muted-foreground">
            <Receipt class="size-4" /> Transactions
          </span>
        </nav>
        <div class="flex flex-col gap-0.5 border-t border-border pt-3">
          <span class="px-2 pb-1 text-xs font-medium text-muted-foreground">Accounts</span>
          {DEMO_ACCOUNTS.map((account) => (
            <span class="flex items-center gap-1.5 rounded-md px-2 py-1">
              <span class="truncate">{account.name}</span>
              {account.uncleared && <span class="size-1.5 shrink-0 rounded-full bg-danger-foreground" />}
              <span class="ml-auto font-number text-xs text-muted-foreground tabular-nums">
                {formatUsd(account.balance)}
              </span>
            </span>
          ))}
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col gap-3 p-3 @lg:p-4">
        <div class="flex items-center gap-2">
          <span class="flex size-6 items-center justify-center rounded-md text-muted-foreground">
            <ChevronLeft class="size-4" />
          </span>
          <span class="text-base font-semibold tracking-tight">{DEMO_MONTH}</span>
          <span class="flex size-6 items-center justify-center rounded-md text-muted-foreground">
            <ChevronRight class="size-4" />
          </span>
          <div class="ml-auto hidden items-center rounded-md border border-border bg-muted/60 p-0.5 text-xs @lg:flex">
            <span class="rounded-sm bg-background px-2 py-0.5 font-medium shadow-xs">All</span>
            <span class="px-2 py-0.5 text-muted-foreground">Underfunded</span>
            <span class="px-2 py-0.5 text-danger-foreground">Overspent</span>
          </div>
        </div>

        <div class="flex items-center justify-between gap-4 rounded-lg border border-success-foreground/20 bg-success px-4 py-3">
          <div>
            <div class="font-number text-xl font-medium tracking-tight text-success-foreground tabular-nums">
              {formatUsd(READY_TO_ASSIGN)}
            </div>
            <div class="text-xs font-medium text-muted-foreground">Ready to Assign</div>
          </div>
          <span class="inline-flex h-7 items-center rounded-md border border-border bg-background px-2.5 text-xs font-medium shadow-xs">
            Assign
          </span>
        </div>

        <div class="overflow-hidden rounded-lg border border-border">
          <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_6.5rem] border-b border-border bg-muted/40 py-2 text-xs font-medium text-muted-foreground @lg:grid-cols-[minmax(0,1fr)_6rem_6rem_6.5rem]">
            <span class="pl-3">Category</span>
            <span class="pr-2 text-right @lg:px-3">Assigned</span>
            <span class="hidden px-3 text-right @lg:block">Activity</span>
            <span class="pr-3 text-right @lg:px-3">Available</span>
          </div>
          {DEMO_GROUPS.map((group, index) => (
            <div class="border-b border-border last:border-b-0">
              <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_6.5rem] bg-muted/40 py-1.5 text-xs font-semibold @lg:grid-cols-[minmax(0,1fr)_6rem_6rem_6.5rem]">
                <span class="flex items-center gap-1 pl-3">
                  <ChevronDown class="size-3.5 text-muted-foreground" />
                  {group.name}
                </span>
                <span class="pr-2 text-right font-number tabular-nums @lg:px-3">
                  {formatUsd(groupTotal('assigned', index))}
                </span>
                <span class="hidden px-3 text-right font-number tabular-nums @lg:block">
                  {formatUsd(groupTotal('activity', index))}
                </span>
                <span class="pr-3 text-right font-number tabular-nums @lg:px-3">
                  {formatUsd(groupTotal('available', index))}
                </span>
              </div>
              {group.categories.map((category) => (
                <div class="grid grid-cols-[minmax(0,1fr)_5.5rem_6.5rem] items-center border-t border-border/60 py-1.5 @lg:grid-cols-[minmax(0,1fr)_6rem_6rem_6.5rem]">
                  <span class="flex min-w-0 flex-col gap-1 pr-2 pl-8">
                    <span class="truncate">{category.name}</span>
                    {category.target !== undefined && (
                      <span
                        class:list={[
                          'h-1 w-full max-w-36 overflow-hidden rounded-full',
                          category.underfunded ? 'bg-warning' : 'bg-success',
                        ]}
                      >
                        <span
                          class:list={[
                            'block h-full rounded-full',
                            category.underfunded ? 'bg-warning-bar' : 'bg-success-foreground',
                          ]}
                          style={`width: ${category.target * 100}%`}
                        />
                      </span>
                    )}
                  </span>
                  <span class="pr-2 text-right font-number tabular-nums @lg:px-3">{formatUsd(category.assigned)}</span>
                  <span
                    class:list={[
                      'hidden px-3 text-right font-number tabular-nums @lg:block',
                      category.activity === 0 && 'text-muted-foreground',
                    ]}
                  >
                    {formatUsd(category.activity)}
                  </span>
                  <span class="flex justify-end pr-3 @lg:px-3">
                    <AvailablePill amount={category.available} underfunded={category.underfunded} />
                  </span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</MockFrame>
