---
import { Redo2, Undo2 } from '@lucide/astro';

const history = [
  'Assigned $200.00 to Vacation',
  'Moved $21.40 from Groceries to Dining out',
  'Deleted "Coffee" ($4.50)',
];
---

<div class="flex flex-col gap-2.5 text-[13px]">
  <div class="flex items-center gap-2">
    <span class="flex h-8 items-center gap-1.5 rounded-md border border-border bg-background px-2.5 font-medium shadow-xs">
      <Undo2 class="size-4" /> Undo
      <kbd class="ml-1 rounded border border-border bg-muted px-1 font-sans text-[10px] text-muted-foreground">⌘Z</kbd>
    </span>
    <span class="flex size-8 items-center justify-center rounded-md border border-border text-muted-foreground">
      <Redo2 class="size-4" />
    </span>
  </div>
  <ol class="flex flex-col rounded-lg border border-border">
    {history.map((item, index) => (
      <li
        class:list={[
          'border-b border-border/60 px-3 py-2 last:border-b-0',
          index === 0 ? 'bg-muted/50 font-medium' : 'text-muted-foreground',
        ]}
      >
        {item}
      </li>
    ))}
  </ol>
</div>
