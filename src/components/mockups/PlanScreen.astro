---
import {
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  CirclePlus,
  Redo2,
  RotateCcwClock,
  TriangleAlert,
  Undo2,
} from '@lucide/astro';
import AvailablePill from './AvailablePill.astro';
import CategoryPanel from './CategoryPanel.astro';
import { groupTotal, isUnderfunded } from '../../content/demo-budget';
import { useI18n } from '../../i18n';

/**
 * The Plan page (budget-screen.tsx, budget-toolbar.tsx, budget-table.tsx, group-block.tsx), meant
 * for AppWindow's main area. Below 42rem it switches to the app's phone table: Category, Assigned
 * and Available edge to edge, no checkboxes. `panel` adds the selected category's detail panel.
 */
interface Props {
  panel?: boolean;
}

const { panel = false } = Astro.props;
const { t, demo, money: format } = useI18n(Astro);
const copy = t.app;
const all = demo.groups.flatMap((g) => g.categories);
const overspent = all.filter((c) => c.available < 0).length;
const underfunded = all.filter(isUnderfunded).length;

const grid =
  'grid grid-cols-[minmax(0,1fr)_7rem_6.5rem] items-center @2xl/main:grid-cols-[4.5rem_minmax(5rem,1fr)_9.5rem_9.5rem_9.5rem]';
const money = 'font-number whitespace-nowrap tabular-nums';
const checkbox = 'size-4 rounded-[4px] border border-input bg-background shadow-xs';
---

<div class:list={['grid gap-4', panel && '@5xl/main:grid-cols-[minmax(0,1fr)_20rem] @5xl/main:items-start']}>
  <div class="flex min-w-0 flex-col gap-2 text-sm @2xl/main:gap-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="hidden text-xl font-semibold tracking-tight @2xl/main:block">{copy.budget}</h1>
      <div class="flex items-center gap-1">
        <span class="flex size-7 items-center justify-center rounded-md border border-border bg-background shadow-xs">
          <ChevronLeft class="size-4" />
        </span>
        <span class="w-36 truncate text-center text-sm font-medium">{demo.month}</span>
        <span class="flex size-7 items-center justify-center rounded-md border border-border bg-background shadow-xs">
          <ChevronRight class="size-4" />
        </span>
        <span class="ml-1 hidden h-7 items-center rounded-md px-2.5 text-[0.8rem] font-medium text-muted-foreground opacity-50 @2xl/main:inline-flex">
          {copy.today}
        </span>
      </div>
      <span class="flex h-7 items-center gap-1 rounded-md border border-input bg-background px-2.5 text-[0.8rem] font-medium shadow-xs @2xl/main:hidden">
        <TriangleAlert class="size-3.5 text-danger-foreground" />
        {copy.all}
        <ChevronDown class="size-3.5 text-muted-foreground" />
      </span>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 rounded-lg border border-success-foreground/20 bg-success px-4 py-3">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <div>
          <div class="font-number text-xl font-medium tracking-tight text-success-foreground tabular-nums @2xl/main:text-2xl">
            {format(demo.readyToAssign)}
          </div>
          <div class="text-xs font-medium text-muted-foreground">{copy.readyToAssign}</div>
        </div>
      </div>
      <span class="inline-flex h-7 items-center gap-1 rounded-md border border-border bg-background px-2.5 text-[0.8rem] font-medium shadow-xs">
        {copy.assign} <ChevronDown class="size-3.5" />
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-x-0.5 gap-y-1">
      <div class="mr-2 hidden items-center rounded-md border border-border bg-muted/60 p-0.5 @2xl/main:flex">
        <span class="inline-flex h-7 items-center rounded-sm bg-background px-2 text-xs font-medium shadow-xs">
          {copy.all}
        </span>
        <span class="inline-flex h-7 items-center gap-1 rounded-sm px-2 text-xs font-medium text-danger-foreground">
          <TriangleAlert class="size-3.5" />
          {copy.overspent(overspent)}
        </span>
        <span class="inline-flex h-7 items-center rounded-sm px-2 text-xs font-medium text-muted-foreground">
          {copy.underfunded(underfunded)}
        </span>
        <span class="inline-flex h-7 items-center rounded-sm px-2 text-xs font-medium text-muted-foreground">
          {copy.overfunded}
        </span>
      </div>
      <span class="inline-flex h-7 items-center gap-1 rounded-md px-1.5 text-xs font-medium text-primary">
        <CirclePlus class="size-3.5" /> {copy.categoryGroup}
      </span>
      <span class="inline-flex h-7 items-center gap-1 rounded-md px-1.5 text-xs">
        <Undo2 class="size-3.5" />
        <span class="hidden @lg/main:inline">{copy.undo}</span>
      </span>
      <span class="inline-flex h-7 items-center gap-1 rounded-md px-1.5 text-xs text-muted-foreground opacity-40">
        <Redo2 class="size-3.5" />
        <span class="hidden @lg/main:inline">{copy.redo}</span>
      </span>
      <span class="inline-flex h-7 items-center gap-1 rounded-md px-1.5 text-xs text-muted-foreground">
        <RotateCcwClock class="size-3.5" />
        <span class="hidden @lg/main:inline">{copy.moves}</span>
      </span>
    </div>

    <div class="-mx-4 overflow-hidden border-y border-border @2xl/main:mx-0 @2xl/main:rounded-lg @2xl/main:border-x">
      <div
        class:list={[
          grid,
          'h-8 border-b border-border bg-background text-[0.6875rem] font-medium tracking-wide text-muted-foreground uppercase',
        ]}
      >
        <span class="hidden items-center gap-1.5 self-stretch pr-2 pl-1 @2xl/main:flex">
          <span class="size-4"></span>
          <ChevronDown class="size-3.5" />
          <span class={checkbox}></span>
        </span>
        <span class="pr-2 pl-3 @2xl/main:pl-0">{copy.columns.category}</span>
        <span class="pr-2 text-right @2xl/main:px-3">{copy.columns.assigned}</span>
        <span class="hidden px-3 text-right @2xl/main:block">{copy.columns.activity}</span>
        <span class="pr-5 text-right @2xl/main:px-3">{copy.columns.available}</span>
      </div>

      {demo.groups.map((group) => (
        <div class="border-t border-border first:border-t-0">
          <div class:list={[grid, 'bg-muted/80 py-1 text-[0.8125rem] font-semibold']}>
            <span class="hidden items-center gap-1.5 self-stretch pr-2 pl-1 @2xl/main:flex">
              <span class="size-4" />
              <ChevronDown class="size-3.5 text-muted-foreground" />
              <span class={checkbox} />
            </span>
            <span class="flex min-w-0 items-center gap-1 pr-2 pl-3 @2xl/main:pl-0">
              <ChevronDown class="size-3.5 text-muted-foreground @2xl/main:hidden" />
              <span class="truncate">{group.name}</span>
            </span>
            <span class:list={[money, 'pr-2 text-right @2xl/main:pr-[1.1rem]']}>
              {format(groupTotal(group, 'assigned'))}
            </span>
            <span class:list={[money, 'hidden px-3 text-right @2xl/main:block']}>
              {format(groupTotal(group, 'activity'))}
            </span>
            <span class:list={[money, 'pr-5 text-right']}>{format(groupTotal(group, 'available'))}</span>
          </div>
          {group.categories.map((c) => {
            const selected = panel && c.name === demo.selected.name;
            return (
              <div class:list={[grid, 'border-t border-border py-1 text-sm', selected ? 'bg-muted' : 'bg-background']}>
                <span class="hidden items-center gap-1.5 self-stretch pr-2 pl-1 @2xl/main:flex">
                  <span class="size-4" />
                  <span class="size-4" />
                  {selected ? (
                    <span class="flex size-4 items-center justify-center rounded-[4px] border border-primary bg-primary text-primary-foreground">
                      <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </span>
                  ) : (
                    <span class={checkbox} />
                  )}
                </span>
                <span class="flex min-w-0 items-center gap-1 pr-2 pl-3 @2xl/main:pl-0">
                  <span class="truncate">{c.name}</span>
                  {c.snoozed && <span class="text-xs">💤</span>}
                </span>
                <span class="px-0.5 @2xl/main:px-1.5">
                  <span
                    class:list={[
                      money,
                      'flex h-7 items-center justify-end rounded-md px-2',
                      c.assigned === 0 && 'text-muted-foreground',
                    ]}
                  >
                    {format(c.assigned)}
                  </span>
                </span>
                <span
                  class:list={[
                    money,
                    'hidden px-3 text-right @2xl/main:block',
                    c.activity === 0 && 'text-muted-foreground',
                  ]}
                >
                  {format(c.activity)}
                </span>
                <span class="flex justify-end pr-3 @2xl/main:px-3">
                  <span class="rounded-full p-0.5">
                    <AvailablePill amount={c.available} underfunded={isUnderfunded(c)} />
                  </span>
                </span>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>

  {panel && <CategoryPanel class="hidden @5xl/main:block" />}
</div>
