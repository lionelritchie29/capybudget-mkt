---
import { ChartColumn, Landmark, LayoutGrid, Receipt, Settings } from '@lucide/astro';
import PlanScreen from './PlanScreen.astro';
import { useI18n } from '../../i18n';

/**
 * The app on a phone: a true 375px-wide screen (so PlanScreen takes its phone layout) shrunk with
 * CSS zoom to fit the frame, with the floating tab bar from app-shell.tsx.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { t } = useI18n(Astro);
const tabs = [
  { label: t.app.nav.plan, icon: LayoutGrid, active: true },
  { label: t.app.nav.transactions, icon: Receipt },
  { label: t.app.nav.accounts, icon: Landmark },
  { label: t.app.nav.reports, icon: ChartColumn },
  { label: t.app.nav.settings, icon: Settings },
];
---

<div
  role="img"
  aria-label={t.app.phoneLabel}
  class:list={[
    'relative w-fit shrink-0 rounded-[2.9rem] border border-border bg-card p-2.5 shadow-mock dark:bg-sidebar',
    className,
  ]}
>
  <div aria-hidden="true" inert class="overflow-hidden rounded-[2.3rem] bg-background">
    <div class="relative h-[812px] w-[375px] [zoom:0.76]">
      <div class="flex items-center justify-between px-8 pt-4 pb-1 text-sm font-semibold">
        <span>9:41</span>
        <span class="h-7 w-28 rounded-full bg-foreground"></span>
        <span class="h-3 w-6 rounded-[4px] border-2 border-foreground/70"></span>
      </div>
      <div class="@container/main p-4 pt-[calc(1rem+10px)]">
        <PlanScreen />
      </div>
      <div class="absolute inset-x-5 bottom-3 z-30 flex justify-around rounded-2xl border border-border bg-background p-1 shadow-lg shadow-black/10">
        {tabs.map(({ label, icon: Icon, active }) => (
          <span
            class:list={[
              'flex flex-1 flex-col items-center gap-0.5 rounded-xl px-1 py-1 text-xs',
              active ? 'bg-muted font-medium text-foreground' : 'text-muted-foreground',
            ]}
          >
            <Icon class="size-5 shrink-0" />
            {label}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
