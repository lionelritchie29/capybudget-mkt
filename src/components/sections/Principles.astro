---
import { Coins, Globe, Scale, ShieldCheck } from '@lucide/astro';
import { useI18n } from '../../i18n';

const { t } = useI18n(Astro);
const icons = [Coins, Scale, ShieldCheck, Globe];
const principles = t.principles.map((p, i) => ({ ...p, icon: icons[i] }));
---

<section class="border-y border-border bg-sidebar/60">
  <ul class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    {principles.map(({ icon: Icon, title, body }) => (
      <li class="reveal flex flex-col gap-2">
        <span class="flex size-8 items-center justify-center rounded-md border border-border bg-background">
          <Icon class="size-4 text-brand-strong" aria-hidden="true" />
        </span>
        <h3 class="text-[0.9375rem] font-semibold">{title}</h3>
        <p class="text-sm text-muted-foreground">{body}</p>
      </li>
    ))}
  </ul>
</section>
