---
import { Check } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import PhoneMock from '../mockups/PhoneMock.astro';
import { feature } from '../../content/features';
import { useI18n } from '../../i18n';

const { locale, t } = useI18n(Astro);
const { heading, body, points } = feature(locale, 'mobile');
---

<section class="mx-auto grid max-w-6xl items-center gap-14 overflow-x-clip px-4 py-20 sm:px-6 sm:py-28 md:grid-cols-[1fr_auto] lg:gap-24">
  <div class="flex flex-col gap-6">
    <SectionHeading eyebrow={t.mobile.eyebrow} title={heading} align="left">
      {body}
    </SectionHeading>
    <ul class="reveal flex flex-col gap-2.5 text-sm">
      {points.map((point) => (
        <li class="flex gap-2.5">
          <Check class="mt-0.5 size-4 shrink-0 text-success-foreground" aria-hidden="true" />
          {point}
        </li>
      ))}
    </ul>
  </div>
  <div class="reveal relative mx-auto">
    <div class="glow absolute -inset-10 -z-10" aria-hidden="true"></div>
    <PhoneMock />
  </div>
</section>
