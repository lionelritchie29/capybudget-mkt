---
import { Image } from 'astro:assets';
import capy from '../../assets/capy-icon.png';
import AppWindow from '../mockups/AppWindow.astro';
import PlanScreen from '../mockups/PlanScreen.astro';
import WaitlistForm from '../WaitlistForm.astro';
import { useI18n } from '../../i18n';

const { t, demo, moneyShort } = useI18n(Astro);
---

<section class="relative isolate overflow-hidden">
  <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto flex max-w-6xl flex-col items-center px-4 pt-16 text-center sm:px-6 sm:pt-24">
    <span class="eyebrow">
      <span class="size-1.5 rounded-full bg-brand"></span>
      {t.hero.eyebrow}
    </span>

    <h1 class="mt-6 max-w-3xl text-[2.75rem] leading-[1.05] font-semibold tracking-tighter sm:text-6xl lg:text-7xl">
      {t.hero.titleLead}{' '}
      <span class="bg-linear-to-r from-brand-strong via-brand to-onsen bg-clip-text text-transparent">
        {t.hero.titleAccent}
      </span>
    </h1>

    <p class="mt-5 max-w-xl text-base text-muted-foreground sm:text-lg">{t.hero.body}</p>

    <div id="waitlist" class="mt-8 flex w-full justify-center scroll-mt-28">
      <WaitlistForm source="hero" class="text-left" />
    </div>
  </div>

  <div class="relative mx-auto mt-14 max-w-5xl px-4 pb-20 sm:mt-16 sm:px-6 sm:pb-28">
    <div class="glow absolute inset-x-0 -top-10 -bottom-10 -z-10" aria-hidden="true"></div>
    <div class="relative">
      <!-- The capybara soaks on the corner of the window. -->
      <Image
        src={capy}
        alt=""
        width={120}
        height={120}
        densities={[1, 2]}
        loading="eager"
        class="absolute -top-14 -right-2 z-10 w-20 drop-shadow-lg sm:-top-20 sm:-right-6 sm:w-30"
      />
      <AppWindow
        active="plan"
        label={t.hero.mockLabel({
          month: demo.month,
          ready: moneyShort(demo.readyToAssign),
          groups: demo.groups.map((g) => g.name),
        })}
      >
        <PlanScreen />
      </AppWindow>
    </div>
  </div>
</section>
