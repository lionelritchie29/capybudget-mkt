---
import { ArrowRight } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import MoveMoneyMock from '../mockups/MoveMoneyMock.astro';
import ReconcileMock from '../mockups/ReconcileMock.astro';
import ReportsMock from '../mockups/ReportsMock.astro';
import ScheduledMock from '../mockups/ScheduledMock.astro';
import SplitMock from '../mockups/SplitMock.astro';
import TargetMock from '../mockups/TargetMock.astro';
import UndoMock from '../mockups/UndoMock.astro';
import YnabMock from '../mockups/YnabMock.astro';
import { feature } from '../../content/features';

const tiles = [
  { id: 'plan', mock: MoveMoneyMock, span: 'lg:col-span-4' },
  { id: 'targets', mock: TargetMock, span: 'lg:col-span-2' },
  { id: 'reports', mock: ReportsMock, span: 'lg:col-span-2' },
  { id: 'scheduled', mock: ScheduledMock, span: 'lg:col-span-2' },
  { id: 'transactions', mock: SplitMock, span: 'lg:col-span-2' },
  { id: 'reconcile', mock: ReconcileMock, span: 'lg:col-span-2' },
  { id: 'undo', mock: UndoMock, span: 'lg:col-span-2' },
  { id: 'ynab', mock: YnabMock, span: 'lg:col-span-2' },
].map((tile) => ({ ...tile, ...feature(tile.id) }));
---

<section id="features" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
  <SectionHeading eyebrow="Everything in one calm place" title="All the envelope budgeting. None of the stress.">
    The tools you need to run a monthly plan, and none of the ones that make you feel behind.
  </SectionHeading>

  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
    {tiles.map(({ mock: Mock, span, title, blurb, id }) => (
      <article
        class:list={[
          'reveal group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-foreground/15',
          span,
          id === 'plan' && 'sm:col-span-2',
        ]}
      >
        <div class="flex flex-col gap-1.5 p-5 pb-4">
          <h3 class="font-semibold">{title}</h3>
          <p class="text-sm text-muted-foreground">{blurb}</p>
        </div>
        <div class="flex flex-1 flex-col justify-center px-5 pb-5" aria-hidden="true" inert>
          <div class="rounded-lg border border-border/70 bg-background p-3 dark:bg-background/60">
            <Mock />
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-10 flex justify-center">
    <a
      href="/features"
      class="inline-flex items-center gap-1.5 rounded-md text-sm font-medium outline-none hover:underline hover:underline-offset-4 focus-visible:ring-2 focus-visible:ring-ring"
    >
      See every feature <ArrowRight class="size-4" aria-hidden="true" />
    </a>
  </div>
</section>
