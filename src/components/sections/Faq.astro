---
import { Plus } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import { useI18n } from '../../i18n';

const { t } = useI18n(Astro);
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
  <SectionHeading eyebrow={t.faq.eyebrow} title={t.faq.title} />
  <div class="reveal mt-12 divide-y divide-border border-y border-border">
    {t.faq.items.map(({ q, a }) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-medium outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
          {q}
          <Plus
            class="size-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true"
          />
        </summary>
        <p class="pr-8 pb-5 text-sm leading-relaxed text-muted-foreground">{a}</p>
      </details>
    ))}
  </div>
</section>
