---
import { Image } from 'astro:assets';
import capy from '../../assets/capy-icon.png';
import Base from '../../layouts/Base.astro';
import Button from '../ui/Button.astro';
import { SIGN_IN_URL } from '../../lib/site';
import { useI18n } from '../../i18n';

const { t, path } = useI18n(Astro);
const copy = t.notFound;
---

<Base title={copy.title} noindex alternates={false}>
  <section class="mx-auto flex max-w-md flex-col items-center gap-5 px-4 py-24 text-center sm:py-32">
    <Image src={capy} alt="" width={112} height={112} densities={[1, 2]} />
    <h1 class="text-3xl font-semibold tracking-tighter">{copy.heading}</h1>
    <p class="text-muted-foreground">{copy.body}</p>
    <div class="flex flex-wrap justify-center gap-2">
      <Button href={path('/')} size="lg">
        {copy.home}
      </Button>
      <Button href={SIGN_IN_URL} variant="outline" size="lg">
        {copy.app}
      </Button>
    </div>
  </section>
</Base>
