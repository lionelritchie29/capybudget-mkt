---
import { Menu, X } from '@lucide/astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from './ui/Button.astro';
import { NAV_LINKS, SIGN_IN_URL } from '../lib/site';

const path = Astro.url.pathname;
const waitlistHref = path === '/' ? '#waitlist' : '/#waitlist';
---

<header class="nav-shell sticky top-0 z-40 border-b bg-background/75 backdrop-blur-lg">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label="Capybudget home"
    >
      <Logo />
    </a>

    <ul class="ml-6 hidden items-center gap-1 md:flex">
      {NAV_LINKS.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={href === path ? 'page' : undefined}
            class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring aria-[current=page]:text-foreground"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-1.5">
      <Button href={SIGN_IN_URL} variant="ghost" class="max-sm:hidden">
        Sign in
      </Button>
      <ThemeToggle />
      <Button href={waitlistHref}>
        Join<span class="max-sm:hidden"> the</span> waitlist
      </Button>

      <details class="group relative md:hidden" data-mobile-menu>
        <summary
          class="tap-target flex size-(--control-h) cursor-pointer list-none items-center justify-center rounded-md text-muted-foreground outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Menu class="size-(--control-icon) group-open:hidden" aria-hidden="true" />
          <X class="hidden size-(--control-icon) group-open:block" aria-hidden="true" />
        </summary>
        <div class="absolute top-full right-0 mt-2 w-56 rounded-lg border border-border bg-popover p-1.5 text-popover-foreground shadow-lg">
          <ul>
            {NAV_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} class="flex rounded-md px-3 py-(--menu-item-py) text-sm hover:bg-muted">
                  {label}
                </a>
              </li>
            ))}
            <li class="mt-1 border-t border-border pt-1">
              <a href={SIGN_IN_URL} class="flex rounded-md px-3 py-(--menu-item-py) text-sm hover:bg-muted">
                Sign in
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // Close the phone menu after picking a link (in-page anchors don't reload) or tapping outside.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  /* The bottom border fades in over the first 80px of scroll; without scroll timelines it is always there. */
  @supports (animation-timeline: scroll()) {
    .nav-shell {
      animation: nav-border linear both;
      animation-timeline: scroll();
      animation-range: 0 80px;
    }
  }

  @keyframes nav-border {
    from {
      border-bottom-color: transparent;
    }
    to {
      border-bottom-color: var(--border);
    }
  }
</style>
