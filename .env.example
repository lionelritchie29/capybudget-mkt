# Vercel (server only): the waitlist writes to Supabase and sends a confirmation via Resend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Optional; defaults to "Capybudget <hello@capybudget.site>".
WAITLIST_FROM_EMAIL=

# Local only, for `pnpm screenshots` (put these in .env.local).
SCREENSHOT_EMAIL=
SCREENSHOT_PASSWORD=
SCREENSHOT_APP_URL=https://staging.capybudget.site
SCREENSHOT_TARGET_CATEGORY=Vacation
